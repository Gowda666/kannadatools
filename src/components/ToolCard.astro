---
// Reusable Tool Card component for KannadaTools
import { t } from '../lib/i18n';

interface Props {
  href: string;
  titleKey: string;
  descKey: string;
  isComingSoon?: boolean;
  accentColor?: 'red' | 'amber' | 'emerald' | 'blue';
  iconType: 'transliterate' | 'cleaner' | 'ocr' | 'speech';
}

const {
  href,
  titleKey,
  descKey,
  isComingSoon = true,
  accentColor = 'red',
  iconType,
} = Astro.props;

const colorMap = {
  red: {
    bg: 'bg-red-50',
    border: 'border-red-200 hover:border-red-500',
    iconBg: 'bg-red-600 text-white',
    badge: 'bg-amber-100 text-amber-900 border-amber-300',
    hoverText: 'group-hover:text-red-600',
    btnHover: 'hover:bg-red-600 hover:text-white',
  },
  amber: {
    bg: 'bg-amber-50/50',
    border: 'border-amber-200 hover:border-amber-500',
    iconBg: 'bg-amber-500 text-white',
    badge: 'bg-amber-100 text-amber-900 border-amber-300',
    hoverText: 'group-hover:text-amber-700',
    btnHover: 'hover:bg-amber-600 hover:text-white',
  },
  emerald: {
    bg: 'bg-emerald-50/50',
    border: 'border-emerald-200 hover:border-emerald-500',
    iconBg: 'bg-emerald-600 text-white',
    badge: 'bg-amber-100 text-amber-900 border-amber-300',
    hoverText: 'group-hover:text-emerald-700',
    btnHover: 'hover:bg-emerald-600 hover:text-white',
  },
  blue: {
    bg: 'bg-sky-50/50',
    border: 'border-sky-200 hover:border-sky-500',
    iconBg: 'bg-sky-600 text-white',
    badge: 'bg-amber-100 text-amber-900 border-amber-300',
    hoverText: 'group-hover:text-sky-700',
    btnHover: 'hover:bg-sky-600 hover:text-white',
  },
};

const c = colorMap[accentColor];
---

<div class={`relative group flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-white border ${c.border} shadow-sm hover:shadow-md transition-all duration-200`}>
  <div>
    <!-- Top Row: Icon + Badge -->
    <div class="flex items-center justify-between mb-5">
      <div class={`w-12 h-12 rounded-xl ${c.iconBg} flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform`}>
        {iconType === 'transliterate' && (
          <!-- Keyboard / A -> ಕ transliteration icon -->
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        )}
        {iconType === 'cleaner' && (
          <!-- Sparkles / text clean icon -->
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
        )}
        {iconType === 'ocr' && (
          <!-- Scan / Document Camera OCR icon -->
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        )}
        {iconType === 'speech' && (
          <!-- Audio / Microphone Speech icon -->
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
        )}
      </div>

      <!-- Coming Soon or Status Badge -->
      {isComingSoon && (
        <span class={`inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full border ${c.badge}`}>
          <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>
          <span data-i18n="comingSoonBadge">{t('comingSoonBadge')}</span>
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class={`text-xl font-bold text-slate-900 ${c.hoverText} transition-colors tracking-tight mb-2.5`}>
      <a href={href} class="focus:outline-none focus:underline" data-i18n={titleKey}>
        {t(titleKey)}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-slate-600 leading-relaxed mb-6" data-i18n={descKey}>
      {t(descKey)}
    </p>
  </div>

  <!-- Footer Link Button -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
    <a
      href={href}
      class={`inline-flex items-center gap-2 text-sm font-semibold text-slate-700 ${c.hoverText} group-hover:translate-x-0.5 transition-all focus:outline-none`}
    >
      <span data-i18n="openToolBtn">{t('openToolBtn')}</span>
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <!-- Browser execution note -->
    <span class="text-[11px] font-medium text-slate-600 bg-slate-100 px-2 py-0.5 rounded">
      ಬ್ರೌಸರ್-ಮಾತ್ರ / Client-only
    </span>
  </div>
</div>

