---
// Footer component with open source attribution, quick links, and bilingual text
import { t } from '../lib/i18n';
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Brand & Mission statement -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-red-600 to-amber-400 flex items-center justify-center text-white font-bold text-lg shadow">
            <span>ಕ</span>
          </div>
          <span class="text-2xl font-black text-white" data-i18n="siteName">
            {t('siteName')}
          </span>
          <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-red-950/80 text-red-300 border border-red-800" data-i18n="openSourceBadge">
            {t('openSourceBadge')}
          </span>
        </div>

        <p class="text-slate-400 text-sm max-w-md leading-relaxed" data-i18n="footerDescription">
          {t('footerDescription')}
        </p>

        <p class="text-xs text-amber-300/80 font-medium" data-i18n="footerZeroCostNote">
          {t('footerZeroCostNote')}
        </p>
      </div>

      <!-- Quick Tool Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          <span data-i18n="navHome">ಉಪಕರಣಗಳು</span> / Tools
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/transliterate" class="hover:text-amber-400 transition-colors" data-i18n="navTransliterate">
              {t('navTransliterate')}
            </a>
          </li>
          <li>
            <a href="/cleaner" class="hover:text-amber-400 transition-colors" data-i18n="navCleaner">
              {t('navCleaner')}
            </a>
          </li>
          <li>
            <a href="/ocr" class="hover:text-amber-400 transition-colors" data-i18n="navOcr">
              {t('navOcr')}
            </a>
          </li>
          <li>
            <a href="/speech" class="hover:text-amber-400 transition-colors" data-i18n="navSpeech">
              {t('navSpeech')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Supporting & Community Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          <span>ಸಂಪರ್ಕ & ಮುಕ್ತತೆ</span> / Community
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/about" class="hover:text-amber-400 transition-colors" data-i18n="navAbout">
              {t('navAbout')}
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-amber-400 transition-colors" data-i18n="navContact">
              {t('navContact')}
            </a>
          </li>
          <li>
            <a href="/request-tool" class="hover:text-amber-400 transition-colors" data-i18n="navCustomTool">
              {t('navCustomTool')}
            </a>
          </li>
          <li>
            <a href="/contact?type=mistake" data-report-mistake="general" class="hover:text-amber-400 transition-colors" data-i18n="navReportMistake">
              {t('navReportMistake')}
            </a>
          </li>
          <li>
            <a 
              href="https://github.com/Gowda666/kannadatools" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 hover:text-amber-400 transition-colors"
              data-i18n="footerSourceCode"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        © {currentYear} ಕನ್ನಡಟೂಲ್ಸ್ (KannadaTools). <span data-i18n="footerLicense">{t('footerLicense')}</span>.
      </div>
      <div class="flex items-center gap-4">
        <a href="/about#privacy" class="hover:text-slate-400 transition-colors">Privacy</a>
        <a href="/about#terms" class="hover:text-slate-400 transition-colors">Terms</a>
        <a href="/LICENSE" class="hover:text-slate-400 transition-colors">MIT License</a>
      </div>
    </div>
  </div>
</footer>

