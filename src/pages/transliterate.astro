---
// Phase 3: Transliteration Tool (/transliterate)
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';
---

<BaseLayout
  title="ಲಿಪ್ಯಂತರಣ (ಇಂಗ್ಲಿಷ್‌ನಿಂದ ಕನ್ನಡ) - ಕನ್ನಡಟೂಲ್ಸ್ | English to Kannada Transliteration"
  description="Free live English to Kannada transliteration tool. Type English phonetics (e.g. namaskara) and get authentic Kannada Unicode script live in your browser."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Top Header & Breadcrumb -->
    <div class="mb-8 text-center sm:text-left flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-semibold uppercase tracking-wider mb-2 border border-red-200">
          <span class="w-2 h-2 rounded-full bg-red-600"></span>
          <span>ಬ್ರೌಸರ್-ಮಾತ್ರ / 100% Client-Side</span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight" data-i18n="transliterateHeading">
          {t('transliterateHeading')}
        </h1>
        <p class="mt-2 text-sm sm:text-base text-slate-600 max-w-2xl" data-i18n="transliterateSubheading">
          {t('transliterateSubheading')}
        </p>
      </div>

      <!-- Scheme Selector -->
      <div class="flex items-center gap-2 self-center sm:self-end bg-white p-1.5 rounded-xl border border-slate-200 shadow-sm text-xs font-medium">
        <label for="scheme-select" class="text-slate-500 pl-2 font-semibold" data-i18n="schemeSelectorLabel">
          {t('schemeSelectorLabel')}
        </label>
        <select
          id="scheme-select"
          class="bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1 text-slate-800 font-semibold focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          <option value="intuitive">ನೈಜ (Intuitive Phonetics)</option>
          <option value="itrans">ಐಟ್ರಾನ್ಸ್ (Strict ITRANS)</option>
        </select>
      </div>
    </div>

    <!-- Quick Example Chips (Click to test) -->
    <div class="mb-6 p-4 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-wrap items-center gap-2">
      <span class="text-xs font-bold text-slate-600 uppercase tracking-wider mr-1" data-i18n="sampleChipsLabel">
        {t('sampleChipsLabel')}
      </span>
      <button type="button" class="sample-chip px-3 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 hover:text-amber-900 text-xs font-semibold text-slate-700 transition-colors border border-slate-200" data-sample="namaskara">
        namaskara (ನಮಸ್ಕಾರ)
      </button>
      <button type="button" class="sample-chip px-3 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 hover:text-amber-900 text-xs font-semibold text-slate-700 transition-colors border border-slate-200" data-sample="kannada">
        kannada (ಕನ್ನಡ)
      </button>
      <button type="button" class="sample-chip px-3 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 hover:text-amber-900 text-xs font-semibold text-slate-700 transition-colors border border-slate-200" data-sample="karnataka">
        karnataka (ಕರ್ನಾಟಕ)
      </button>
      <button type="button" class="sample-chip px-3 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 hover:text-amber-900 text-xs font-semibold text-slate-700 transition-colors border border-slate-200" data-sample="dhanyavada">
        dhanyavada (ಧನ್ಯವಾದ)
      </button>
      <button type="button" class="sample-chip px-3 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 hover:text-amber-900 text-xs font-semibold text-slate-700 transition-colors border border-slate-200" data-sample="bengaluru">
        bengaluru (ಬೆಂಗಳೂರು)
      </button>
      <button type="button" class="sample-chip px-3 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 hover:text-amber-900 text-xs font-semibold text-slate-700 transition-colors border border-slate-200" data-sample="hegiddeera? chennagiddene.">
        hegiddeera? chennagiddene.
      </button>
    </div>

    <!-- Main Live Transliteration Interface (Side by side on desktop, stacked on mobile) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Left: Input English Box -->
      <div class="flex flex-col bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden focus-within:border-red-500 focus-within:ring-2 focus-within:ring-red-100 transition-all">
        <!-- Box Header -->
        <div class="flex items-center justify-between px-4 py-3 bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-700">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
            <span data-i18n="inputBoxLabel">{t('inputBoxLabel')}</span>
          </div>
          <button
            id="clear-btn"
            type="button"
            class="text-slate-500 hover:text-red-600 transition-colors flex items-center gap-1 font-semibold focus:outline-none"
            title="Clear text"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span data-i18n="clearBtn">{t('clearBtn')}</span>
          </button>
        </div>

        <!-- Input Textarea -->
        <textarea
          id="trans-input"
          rows="10"
          class="w-full p-4 text-base sm:text-lg text-slate-900 bg-transparent resize-y focus:outline-none placeholder-slate-400 font-sans"
          data-i18n-placeholder="inputPlaceholder"
          placeholder={t('inputPlaceholder')}
          autofocus
        ></textarea>

        <!-- Box Footer Stats -->
        <div class="px-4 py-2 bg-slate-50 border-t border-slate-100 text-right text-xs text-slate-400 font-mono">
          <span id="input-char-count">0</span> characters
        </div>
      </div>

      <!-- Right: Kannada Script Output Box -->
      <div class="flex flex-col bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden focus-within:border-amber-500 focus-within:ring-2 focus-within:ring-amber-100 transition-all">
        <!-- Box Header -->
        <div class="flex items-center justify-between px-4 py-3 bg-amber-50/60 border-b border-amber-100 text-xs font-semibold text-amber-950">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            <span data-i18n="outputBoxLabel">{t('outputBoxLabel')}</span>
          </div>
          
          <div class="flex items-center gap-2">
            <!-- Copy button -->
            <button
              id="copy-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-xs font-bold transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer"
            >
              <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-btn-text" data-i18n="copyBtn">{t('copyBtn')}</span>
            </button>
          </div>
        </div>

        <!-- Output Textarea (Editable for fine-tuning) -->
        <textarea
          id="trans-output"
          rows="10"
          class="w-full p-4 text-lg sm:text-xl text-slate-900 bg-amber-50/20 resize-y focus:outline-none placeholder-slate-400 font-kannada leading-relaxed"
          data-i18n-placeholder="outputPlaceholder"
          placeholder={t('outputPlaceholder')}
        ></textarea>

        <!-- Box Footer Stats -->
        <div class="px-4 py-2 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <span class="text-emerald-700 font-medium">✓ Unicode Kannada UTF-8</span>
          <span class="font-mono"><span id="output-char-count">0</span> characters</span>
        </div>
      </div>

    </div>

    <!-- Bottom Actions: Report Mistake Link & Privacy Note -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-slate-100/80 border border-slate-200 text-xs text-slate-600">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span data-i18n="reportMistakePrompt">{t('reportMistakePrompt')}</span>:
        <a
          id="report-mistake-link"
          href="/contact?type=mistake"
          data-report-mistake="transliterate"
          class="font-bold text-red-700 hover:text-red-800 underline transition-colors"
        >
          ದೋಷ ವರದಿ ಮಾಡಿ (Feedback)
        </a>
      </div>

      <div class="text-slate-500">
        ಯಾವುದೇ ಡೇಟಾ ಸರ್ವರ್‌ಗೆ ಹೋಗುವುದಿಲ್ಲ (All typing is processed locally in your browser).
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  import { transliterate, type TransliterationScheme } from '../lib/transliterate';

  const inputEl = document.getElementById('trans-input') as HTMLTextAreaElement | null;
  const outputEl = document.getElementById('trans-output') as HTMLTextAreaElement | null;
  const clearBtn = document.getElementById('clear-btn');
  const copyBtn = document.getElementById('copy-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const schemeSelect = document.getElementById('scheme-select') as HTMLSelectElement | null;
  const inputCharCount = document.getElementById('input-char-count');
  const outputCharCount = document.getElementById('output-char-count');
  const reportLink = document.getElementById('report-mistake-link') as HTMLAnchorElement | null;
  const sampleChips = document.querySelectorAll('.sample-chip');

  function updateTransliteration() {
    if (!inputEl || !outputEl) return;
    const text = inputEl.value;
    const scheme = (schemeSelect ? schemeSelect.value : 'intuitive') as TransliterationScheme;

    const result = transliterate(text, scheme);
    outputEl.value = result;

    if (inputCharCount) inputCharCount.textContent = String(text.length);
    if (outputCharCount) outputCharCount.textContent = String(result.length);

    // Update report mistake link with current text context
    if (reportLink && text.trim().length > 0) {
      reportLink.href = `/contact?type=mistake&word=${encodeURIComponent(text.trim().substring(0, 100))}`;
    }
  }

  // Live typing event listener
  if (inputEl) {
    inputEl.addEventListener('input', updateTransliteration);
  }

  // Scheme changer
  if (schemeSelect) {
    schemeSelect.addEventListener('change', updateTransliteration);
  }

  // Clear button
  if (clearBtn && inputEl && outputEl) {
    clearBtn.addEventListener('click', () => {
      inputEl.value = '';
      outputEl.value = '';
      if (inputCharCount) inputCharCount.textContent = '0';
      if (outputCharCount) outputCharCount.textContent = '0';
      inputEl.focus();
    });
  }

  // Copy button
  if (copyBtn && outputEl && copyBtnText) {
    copyBtn.addEventListener('click', async () => {
      const textToCopy = outputEl.value;
      if (!textToCopy) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
        const originalText = copyBtnText.textContent;
        copyBtnText.textContent = 'ನಕಲಿಸಲಾಗಿದೆ! (Copied!)';
        copyBtn.classList.replace('bg-amber-600', 'bg-emerald-600');
        setTimeout(() => {
          copyBtnText.textContent = originalText;
          copyBtn.classList.replace('bg-emerald-600', 'bg-amber-600');
        }, 2000);
      } catch (err) {
        // Fallback copy
        outputEl.select();
        document.execCommand('copy');
      }
    });
  }

  // Sample chips click handlers
  sampleChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const sample = chip.getAttribute('data-sample');
      if (sample && inputEl) {
        inputEl.value = sample;
        updateTransliteration();
        inputEl.focus();
      }
    });
  });
</script>
